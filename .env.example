# Copy to .env and adjust. Every variable is optional.

# --- Agent service (python-service) ---
# Enables Claude-powered planning and report writing. Leave empty to use the
# deterministic, offline-friendly heuristic agents.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# MediaWiki API used as the search backend.
SEARCH_BASE_URL=https://en.wikipedia.org/w/api.php
MAX_SOURCES_PER_QUESTION=3
HTTP_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO

# --- Gateway (backend) ---
GATEWAY_PORT=8080
AGENT_SERVICE_READ_TIMEOUT=120s
RESEARCH_WORKER_THREADS=4
RESEARCH_MAX_STORED_JOBS=500
